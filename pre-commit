#!/bin/bash
# Pre-commit hook - Ruff format check

set -e

STAGED_PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

if [ -n "$STAGED_PYTHON_FILES" ]; then
    if command -v ruff >/dev/null 2>&1; then
        echo "Running ruff format..."
        ruff format $STAGED_PYTHON_FILES
        ruff check --fix $STAGED_PYTHON_FILES
        git add $STAGED_PYTHON_FILES
    else
        echo "Warning: ruff not installed. Install with: pip install ruff"
        exit 1
    fi
fi
