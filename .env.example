# Meeting Transcript Summarizer — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# AI / Summarization  (required)
# ---------------------------------------------------------------------------

# Provider: openai | elsai | huggingface
LLM_PROVIDER=openai

OPENAI_API_KEY=your-openai-api-key-here
# Override for compatible APIs (Azure OpenAI, Elsai, etc.)
# OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Only if LLM_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# Only if LLM_PROVIDER=elsai
# ELSAI_IMPLEMENTATION=native
# ELSAI_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Audio / Video Transcription
# ---------------------------------------------------------------------------

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base
# Language code (e.g. en, es, fr) — leave blank for auto-detect
TRANSCRIPTION_LANGUAGE=en

# ---------------------------------------------------------------------------
# Trello  (optional — skip to disable Trello sync)
# ---------------------------------------------------------------------------

# Get key and token from https://trello.com/app-key
TRELLO_API_KEY=your-trello-api-key-here
TRELLO_API_TOKEN=your-trello-api-token-here

# ---------------------------------------------------------------------------
# Confluence  (optional — skip to disable Confluence sync)
# ---------------------------------------------------------------------------

CONFLUENCE_URL=https://your-workspace.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@example.com
# Generate at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-confluence-api-token-here

# ---------------------------------------------------------------------------
# Microsoft Graph API / Teams  (optional — required for Teams/SharePoint input)
# ---------------------------------------------------------------------------

MS_GRAPH_TENANT_ID=your-tenant-id-here
MS_GRAPH_CLIENT_ID=your-client-id-here
MS_GRAPH_CLIENT_SECRET=your-client-secret-here
# MS_GRAPH_API_BASE=https://graph.microsoft.com/v1.0

# Delegated refresh token for sending email via Graph Mail API
# Obtain via device code flow — see docs/integrations/GRAPH_API_EMAIL_SETUP.md
# MS_GRAPH_REFRESH_TOKEN=your-refresh-token-here

# ---------------------------------------------------------------------------
# SharePoint  (optional — required for SharePoint recording download)
# ---------------------------------------------------------------------------

# SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/yoursite
# SHAREPOINT_CLIENT_ID=your-sharepoint-client-id-here
# SHAREPOINT_CLIENT_SECRET=your-sharepoint-client-secret-here

# ---------------------------------------------------------------------------
# Email Reminders  (optional — skip to disable reminders)
# ---------------------------------------------------------------------------

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-app-password-here   # use app-specific password for Gmail
EMAIL_FROM=your-email@example.com

# Fallback recipient for action items with no assigned owner
PROJECT_OWNER_NAME=Your Name
PROJECT_OWNER_EMAIL=your-email@example.com

# JSON map of owner names to email addresses
OWNER_EMAIL_MAP={"Alice Smith": "alice@example.com", "Bob Jones": "bob@example.com"}

# Reminder schedule
REMINDER_ENABLED=true
REMINDER_AUTO_SEND=true
REMINDER_DAYS_BEFORE=1
REMINDER_CHECK_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# API Security
# ---------------------------------------------------------------------------

# Protects data endpoints with Bearer token auth.
# If unset, auth is disabled (development mode).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_BEARER_TOKEN=your-secret-token-here

# ---------------------------------------------------------------------------
# Server  (optional overrides)
# ---------------------------------------------------------------------------

# HOST=0.0.0.0
# PORT=8000
# RELOAD=true
# ENVIRONMENT=development
# ALLOWED_ORIGINS=*
