[run]
source = backend
omit = 
    */tests/*
    */venv/*
    */__pycache__/*
    */migrations/*
    */alembic/*
    */send_reminders.py
    */meeting_summarizer/integrations/knowledge_base.py
    */meeting_summarizer/core/transcript_processor.py
    */meeting_summarizer/integrations/action_item_manager.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

